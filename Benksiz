--------------------------------------------------------------------
-- LOS CHECK
--------------------------------------------------------------------
local function hasLOS(origin, target)
	if not Settings:Get("WallCheck") then return true end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local myChar = player.Character
	if myChar then params.FilterDescendantsInstances = {myChar} end
	local result = Workspace:Raycast(origin, (target-origin)*0.99, params)
	if not result then return true end
	return Players:GetPlayerFromCharacter(result.Instance.Parent) ~= nil
end

