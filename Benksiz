local silentTarget  = nil
local silentDiedCon = nil

-- Lock HUD chip
local lockChip = create("Frame", {
	Size=UDim2.fromOffset(200,30), AnchorPoint=Vector2.new(0.5,0),
	Position=UDim2.new(0.5,0,0,10),
	BackgroundColor3=Color3.fromRGB(180,30,30), BackgroundTransparency=0.15,
	Visible=false,
}, {corner(8)})
lockChip.Parent = gui

local lockLbl = create("TextLabel", {
	Text="● LOCKED", Font=Enum.Font.GothamBold, TextSize=13,
	TextColor3=Color3.fromRGB(255,255,255), BackgroundTransparency=1,
	Size=UDim2.fromScale(1,1), TextXAlignment=Enum.TextXAlignment.Center,
})
lockLbl.Parent = lockChip

local function attachDiedWatcher(p)
	if silentDiedCon then silentDiedCon:Disconnect() end
	local char = p.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return end

	silentDiedCon = hum.Died:Connect(function()
		task.wait(0.15)
		-- pick next closest excluding the dead one
		local next = getClosest(p)
		silentTarget = next
		if next then
			lockLbl.Text = "● LOCKED: "..next.DisplayName
			attachDiedWatcher(next)
		else
			lockChip.Visible = false
		end
	end)
end

Settings:Connect("SilentAim", function(on)
	if on then
		silentTarget = getClosest()
		if silentTarget then
			lockLbl.Text     = "● LOCKED: "..silentTarget.DisplayName
			lockChip.Visible = true
			attachDiedWatcher(silentTarget)
		end
	else
		silentTarget     = nil
		lockChip.Visible = false
		if silentDiedCon then silentDiedCon:Disconnect() end
	end
end)

-- Every frame: steer camera smoothly to target's HEAD
RunService.RenderStepped:Connect(function()
	if not Settings:Get("SilentAim") then return end

	-- Re-acquire if no target
	if not silentTarget then
		local next = getClosest()
		if next then
			silentTarget     = next
			lockLbl.Text     = "● LOCKED: "..next.DisplayName
			lockChip.Visible = true
			attachDiedWatcher(next)
		end
		return
	end

	local char = silentTarget.Character
	local head = char and char:FindFirstChild("Head")
	local hum  = char and char:FindFirstChildOfClass("Humanoid")
	if not head or not hum or hum.Health <= 0 then return end

	-- Smoothly look at HEAD
	local targetCF = CFrame.new(camera.CFrame.Position, head.Position)
	camera.CFrame  = camera.CFrame:Lerp(targetCF, 0.3)
end)

