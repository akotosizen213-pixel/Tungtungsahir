-- NO RECOIL  (pitch-drift cancel, fire-rate stored for weapon hook)
--------------------------------------------------------------------
local lastPitch = 0
RunService.RenderStepped:Connect(function()
	if not Settings:Get("NoRecoil") then
		lastPitch = select(2, camera.CFrame:ToOrientation())
		return
	end
	local _, pitch, _ = camera.CFrame:ToOrientation()
	local drift = pitch - lastPitch
	if drift > 0.0005 then
		camera.CFrame = camera.CFrame * CFrame.Angles(-drift * 0.97, 0, 0)
	end
	lastPitch = select(2, camera.CFrame:ToOrientation())
end)

