local function buildToggle(feature, order)
	local state = feature.default
	local row = create("TextButton", {
		Text="", AutoButtonColor=false, LayoutOrder=order,
		Size=UDim2.new(1,-6,0,54), BackgroundColor3=THEME.Row,
	}, {corner(16), stroke(THEME.Stroke,1)})

	create("TextLabel", {
		Text=feature.name, Font=Enum.Font.GothamMedium, TextSize=16, TextColor3=THEME.Text,
		BackgroundTransparency=1, Position=UDim2.fromOffset(16,7), Size=UDim2.new(0.55,0,0,20),
		TextXAlignment=Enum.TextXAlignment.Left,
	}).Parent = row
	create("TextLabel", {
		Text=feature.desc, Font=Enum.Font.Gotham, TextSize=11, TextColor3=THEME.SubText,
		BackgroundTransparency=1, Position=UDim2.fromOffset(16,28), Size=UDim2.new(0.55,0,0,16),
		TextXAlignment=Enum.TextXAlignment.Left,
	}).Parent = row

	local sLbl = create("TextLabel", {
		Text="OFF", Font=Enum.Font.Gotham, TextSize=13, TextColor3=THEME.SubText,
		BackgroundTransparency=1, AnchorPoint=Vector2.new(1,0.5),
		Position=UDim2.new(1,-76,0.5,0), Size=UDim2.fromOffset(40,20),
		TextXAlignment=Enum.TextXAlignment.Right,
	})
	sLbl.Parent = row

	local track = create("Frame", {
		AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-14,0.5,0),
		Size=UDim2.fromOffset(52,28), BackgroundColor3=THEME.Off,
	}, {corner(14)})
	local knob = create("Frame", {
		AnchorPoint=Vector2.new(0,0.5), Position=UDim2.fromOffset(3,14),
		Size=UDim2.fromOffset(22,22), BackgroundColor3=THEME.Knob,
	}, {corner(11), stroke(THEME.Stroke,1)})
	knob.Parent  = track
	track.Parent = row

	local function render(anim)
		local t = anim and 0.25 or 0
		tw(track, t, {BackgroundColor3=state and THEME.On or THEME.Off})
		tw(knob,  t, {Position=state and UDim2.fromOffset(27,14) or UDim2.fromOffset(3,14)}, Enum.EasingStyle.Back)
		sLbl.Text = state and "ON" or "OFF"
		tw(sLbl,  t, {TextColor3=state and THEME.Text or THEME.SubText})
	end

	row.MouseButton1Click:Connect(function()
		state = not state; render(true); Settings:Set(feature.id, state)
	end)
	row.MouseEnter:Connect(function() tw(row,0.15,{BackgroundColor3=Color3.fromRGB(20,20,26)}) end)
	row.MouseLeave:Connect(function() tw(row,0.15,{BackgroundColor3=THEME.Row}) end)
	render(false)
	row.Parent = fList

	-- Wire toggle to Settings so external listeners fire
	Settings:Connect(feature.id, function(v)
		if v ~= state then state = v; render(true) end
	end)
end

for i, f in ipairs(FEATURES) do buildToggle(f, i) end

