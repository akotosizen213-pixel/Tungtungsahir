local function create(class, props, children)
	local inst = Instance.new(class)
	for k, v in pairs(props) do inst[k] = v end
	for _, c in ipairs(children or {}) do c.Parent = inst end
	return inst
end
local function corner(r)    return create("UICorner", {CornerRadius=UDim.new(0,r)}) end
local function stroke(c, t) return create("UIStroke", {Color=c, Thickness=t or 1, ApplyStrokeMode=Enum.ApplyStrokeMode.Border}) end
local function tw(obj, time, props, style)
	TweenService:Create(obj, TweenInfo.new(time, style or Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props):Play()
end

local function makeDraggable(frame, handle)
	local dragging, dragStart, startPos
	handle.InputBegan:Connect(function(inp)
		if inp.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
		dragging = true; dragStart = inp.Position; startPos = frame.Position
		inp.Changed:Connect(function()
			if inp.UserInputState == Enum.UserInputState.End then dragging = false end
		end)
	end)
	UserInputService.InputChanged:Connect(function(inp)
		if dragging and inp.UserInputType == Enum.UserInputType.MouseMovement then
			local d = inp.Position - dragStart
			frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset+d.X, startPos.Y.Scale, startPos.Y.Offset+d.Y)
		end
	end)
end

local function makeSlider(parent, yPos, label, minVal, maxVal, defaultVal, callback)
	create("TextLabel", {
		Text=label, Font=Enum.Font.GothamMedium, TextSize=13, TextColor3=THEME.Text,
		BackgroundTransparency=1, Position=UDim2.fromOffset(16, yPos),
		Size=UDim2.new(0.6,0,0,18), TextXAlignment=Enum.TextXAlignment.Left,
	}).Parent = parent

	local valLbl = create("TextLabel", {
		Text=tostring(defaultVal), Font=Enum.Font.GothamMedium, TextSize=13, TextColor3=THEME.Text,
		BackgroundTransparency=1, AnchorPoint=Vector2.new(1,0),
		Position=UDim2.new(1,-16,0,yPos), Size=UDim2.fromOffset(70,18),
		TextXAlignment=Enum.TextXAlignment.Right,
	})
	valLbl.Parent = parent

	local track = create("Frame", {
		Position=UDim2.fromOffset(16, yPos+22), Size=UDim2.new(1,-32,0,7),
		BackgroundColor3=THEME.Off,
	}, {corner(3)})
	track.Parent = parent

	local ratio0 = (defaultVal - minVal) / (maxVal - minVal)
	local fill = create("Frame", {Size=UDim2.fromScale(ratio0,1), BackgroundColor3=THEME.On}, {corner(3)})
	fill.Parent = track

	local dragging = false
	local currentVal = defaultVal

	local function setFromRatio(r)
		r = math.clamp(r,0,1)
		currentVal = math.floor(minVal + r*(maxVal-minVal))
		valLbl.Text = tostring(currentVal)
		fill.Size = UDim2.fromScale(r,1)
		callback(currentVal)
	end

	track.InputBegan:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			setFromRatio((inp.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
	end)
	UserInputService.InputChanged:Connect(function(inp)
		if dragging and inp.UserInputType == Enum.UserInputType.MouseMovement then
			setFromRatio((inp.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X)
		end
	end)

	return valLbl
end

